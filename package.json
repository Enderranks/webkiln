{
  "name": "webkiln-editor",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cloud": "node scripts/build-cloud.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"e2e/**/*.ts\" package.json vite.config.ts tsconfig.json eslint.config.mjs vitest.config.ts playwright.config.ts",
    "worker:type-check": "tsc -p worker/tsconfig.json --noEmit",
    "worker:dev": "wrangler dev --config wrangler.jsonc --local",
    "worker:check": "wrangler deploy --dry-run --config wrangler.jsonc",
    "d1:migrate:local": "wrangler d1 migrations apply webkiln-v10-dev --local --config wrangler.jsonc",
    "d1:migrate:remote": "wrangler d1 migrations apply webkiln-v10-dev --remote --config wrangler.jsonc",
    "worker:deploy": "npm run build:cloud && wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "grapesjs": "^0.22.10",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260919.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wrangler": "^4.135.0"
  }
}
