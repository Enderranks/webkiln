{
  "name": "webkiln-editor",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" package.json vite.config.ts tsconfig.json eslint.config.mjs vitest.config.ts"
  },
  "dependencies": {
    "grapesjs": "^0.22.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@eslint/js": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "typescript-eslint": "^8.18.0",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
